# ===== NVision local environment =====
# Copy to .env and fill the required values:  cp .env.example .env

# --- Required ---
# Google Gemini API key (VLM detections). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Fernet master key for encrypting BYO provider keys at rest.
# Generate with:  python backend/scripts/generate_master_key.py
# (or: docker run --rm python:3.11-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'")
NVISION_MASTER_KEY=

# --- Recommended ---
# Shared secret between backend and ingestion worker (any random string)
WORKER_TOKEN=dev-worker-token

# JWT signing secret for user sessions
JWT_SECRET=devsecret-change-me

# --- Optional ---
# Anthropic API key for the Memory Q&A assistant (feature degrades gracefully without it)
ANTHROPIC_API_KEY=

# Mongo database name
DB_NAME=nvision

# Backend URL as seen from the BROWSER (frontend uses this for /api calls)
REACT_APP_BACKEND_URL=http://localhost:8000

# CORS allowed origins (comma separated)
CORS_ORIGINS=*

# Razorpay credentials for credit top-ups (leave empty to disable payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Worker tuning (defaults are sane) ---
# Motion sampling rate (2-5 fps) on downscaled frames
SAMPLE_FPS=3
# Frames are downscaled to at most this width before motion detection
MAX_FRAME_WIDTH=640
# Minimum moving-contour area as % of the frame to count as motion
MOTION_MIN_AREA_PCT=0.5
# Motion must be sustained across N consecutive sampled frames
MOTION_SUSTAINED_FRAMES=2
# Minimum seconds between ingest POSTs per camera (VLM cooldown is separate, backend-side)
INGEST_MIN_INTERVAL_SECONDS=20
